# NBA Quant Production Environment Variables
# Copy to .env.local for local overrides or configure in Vercel/Netlify Dashboard

# Google AdSense Publisher & Slot IDs (Optional)
# If provided, AdBanner will automatically render official Google display ad units
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_GOOGLE_ADSENSE_SLOT=1234567890

# Custom Domain URL (Used for Canonical & Open Graph tags)
VITE_SITE_URL=https://nbatotals.com
